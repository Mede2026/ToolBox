#include <winres.h>
#include "resource_ids.h"

IDI_APP     ICON   "@CMAKE_SOURCE_DIR@/res/toolbox.ico"
IDR_UI_HTML RCDATA "@CMAKE_BINARY_DIR@/ui_bundle.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Mede2026"
      VALUE "FileDescription", "ToolBox"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "ToolBox"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "ToolBox.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
